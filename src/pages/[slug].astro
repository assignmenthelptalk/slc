---
import ServicePage from "../components/ServicePage.astro";
import LocationPage from "../components/LocationPage.astro";
import { services } from "../data/services";
import { locations } from "../data/locations";

export function getStaticPaths() {
  return [
    ...services.map((service) => ({ params: { slug: service.slug }, props: { kind: "service" as const, service } })),
    ...locations.map((location) => ({ params: { slug: location.slug }, props: { kind: "location" as const, location } })),
  ];
}

const props = Astro.props;
---

{props.kind === "service" ? <ServicePage service={props.service} /> : <LocationPage location={props.location} />}
