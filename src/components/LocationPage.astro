---
import Layout from "./Layout.astro";
import InnerHero from "./InnerHero.astro";
import LeadForm from "./LeadForm.astro";
import FaqList from "./FaqList.astro";
import { site } from "../lib/site";
import { services } from "../data/services";
import { getLocation, type Location } from "../data/locations";

interface Props {
  location: Location;
}
const { location } = Astro.props;

const nearby = location.nearby.flatMap((slug) => {
  const l = getLocation(slug);
  return l ? [l] : [];
});

const title = `Water Softener ${location.city}, UT | ${site.businessName}`;
const description = `Water softener installation, repair, and replacement in ${location.city}, UT. Free in-home water test and written estimate from ${site.businessName}.`;

// One extra, shared question so every city page answers the cost query,
// pointing back to the homepage where the full answer lives.
const faqs = [
  ...location.faqs,
  {
    q: `How much does a water softener cost in ${location.city}?`,
    a: `Most valley homes land between roughly $1,500 and $4,500 installed for a standard salt-based system, depending on capacity and plumbing. We give you a fixed written estimate after a free on-site visit in ${location.city}.`,
  },
];
---

<Layout title={title} description={description}>
  <InnerHero
    trail={[{ name: `${location.city}, UT` }]}
    h1={`Water Softener Installation & Service in ${location.city}, UT`}
    lead={`Free in-home water testing and upfront estimates for ${location.city} homeowners, serving ZIP codes ${location.zips.join(", ")}.`}
  />

  <section class="py-14 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="text-3xl">Water treatment for {location.city} homes</h2>
        <p class="mt-5 text-lg text-muted">
          {site.businessName} serves {location.city}, {location.position}. {location.character}
        </p>
        <p class="mt-4 text-lg text-muted">{location.angle}</p>

        <h2 class="mt-12 text-3xl">Neighborhoods and ZIP codes we serve in {location.city}</h2>
        <div class="mt-5 grid gap-6 sm:grid-cols-2">
          <div class="rounded-brand border border-line bg-white p-5 shadow-card">
            <h3 class="text-xl">Areas</h3>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-muted">
              {location.areas.map((a) => <li>{a}</li>)}
            </ul>
          </div>
          <div class="rounded-brand border border-line bg-white p-5 shadow-card">
            <h3 class="text-xl">ZIP codes</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {location.zips.map((z) => <li class="rounded-full bg-primary-light px-3 py-1 font-semibold text-primary">{z}</li>)}
            </ul>
          </div>
        </div>

        <h2 class="mt-12 text-3xl">Services available in {location.city}</h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {services.map((s) => (
            <li>
              <a href={`/${s.slug}/`} class="flex items-center justify-between rounded-brand border border-line bg-white px-4 py-3 font-semibold text-primary shadow-card hover:border-accent hover:text-accent">
                <span>{s.name}</span>
                <svg class="h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div id="estimate" class="lg:sticky lg:top-24 lg:self-start">
        <LeadForm heading={`Free Estimate in ${location.city}`} idPrefix="loc" context={`${location.city}, UT`} />
      </div>
    </div>
  </section>

  <section class="bg-sand py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h2 class="text-3xl">Water softener questions from {location.city} homeowners</h2>
      <div class="mt-8"><FaqList faqs={faqs} /></div>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-3xl">Also serving nearby</h2>
      <ul class="mt-6 flex flex-wrap gap-3">
        {nearby.map((n) => (
          <li>
            <a href={`/${n.slug}/`} class="inline-block rounded-full border border-line bg-white px-4 py-2 font-semibold text-primary hover:border-accent hover:text-accent">Water softener in {n.city}</a>
          </li>
        ))}
      </ul>
      <p class="mt-10 text-muted">
        {location.city} is part of the wider {site.city} service area covered by
        <a href="/" class="font-semibold text-primary underline underline-offset-4 hover:text-accent">{site.businessName}</a>.
      </p>
      <p class="mt-4">
        <a href="/" class="font-semibold text-accent underline underline-offset-4 hover:text-accent-dark">&larr; Back to {site.businessName} home</a>
      </p>
    </div>
  </section>
</Layout>
