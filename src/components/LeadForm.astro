---
/**
 * LeadForm — plain formsubmit.co POST (no client JS). On success formsubmit.co
 * redirects to /thank-you/. The first submission to a new email address triggers
 * a one-time activation email from formsubmit.co that must be confirmed.
 */
import { site, hasEmail } from "../lib/site";

interface Props {
  heading?: string;
  /** Prefix for input ids so the form can appear on a page more than once */
  idPrefix?: string;
  /** Page context included in the lead email subject */
  context?: string;
}
const {
  heading = "Get Your Free Water Softener Estimate",
  idPrefix = "lead",
  context = "Homepage",
} = Astro.props;

const field =
  "w-full rounded-brand border border-line bg-white px-4 py-3 text-base text-ink placeholder:text-muted/70 focus-visible:border-primary";
const label = "mb-1.5 block text-sm font-semibold text-primary";
---

<form
  action={`https://formsubmit.co/${site.businessEmail}`}
  method="POST"
  class="rounded-brand border border-line bg-white p-6 shadow-float sm:p-8"
>
  <h2 class="text-2xl sm:text-3xl">{heading}</h2>
  <p class="mt-2 text-muted">Tell us what you need. We reply quickly with a written, no-obligation estimate.</p>

  <input type="hidden" name="_subject" value={`New lead - ${site.businessName} (${context})`} />
  <input type="hidden" name="_next" value={`${site.siteUrl}/thank-you/`} />
  <input type="hidden" name="_captcha" value="false" />
  <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <label for={`${idPrefix}-name`} class={label}>Full Name <span class="text-accent">*</span></label>
      <input id={`${idPrefix}-name`} name="name" type="text" required autocomplete="name" class={field} />
    </div>
    <div>
      <label for={`${idPrefix}-email`} class={label}>Email <span class="text-accent">*</span></label>
      <input id={`${idPrefix}-email`} name="email" type="email" required autocomplete="email" class={field} />
    </div>
    <div>
      <label for={`${idPrefix}-phone`} class={label}>Phone Number <span class="text-accent">*</span></label>
      <input id={`${idPrefix}-phone`} name="phone" type="tel" required autocomplete="tel" class={field} />
    </div>
    <div class="sm:col-span-2">
      <label for={`${idPrefix}-service`} class={label}>Describe the service you need</label>
      <textarea
        id={`${idPrefix}-service`}
        name="service_description"
        rows="4"
        class={field}
        placeholder="e.g. New softener for a 4-bedroom home in Sandy, or my old unit stopped regenerating"></textarea>
    </div>
  </div>

  <button
    type="submit"
    disabled={!hasEmail}
    class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-brand bg-accent px-6 py-4 text-lg font-semibold text-white shadow-card transition-transform hover:-translate-y-0.5 hover:bg-accent-dark active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:translate-y-0"
  >
    Get My Free Estimate
    <svg class="h-5 w-5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
    <li>Free, no-obligation estimate</li>
    <li>Local Salt Lake Valley installers</li>
    <li>No credit card required</li>
  </ul>
  {!hasEmail && import.meta.env.DEV && (
    <p class="mt-3 text-xs text-accent">Dev note: set businessEmail in site.config.ts to enable submissions.</p>
  )}
</form>
