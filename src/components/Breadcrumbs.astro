---
import JsonLd from "./JsonLd.astro";
import { site } from "../lib/site";

interface Props {
  trail: { name: string; href?: string }[];
}
const { trail } = Astro.props;
const items = [{ name: "Home", href: "/" }, ...trail];

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.name,
    item: item.href ? new URL(item.href, site.siteUrl).toString() : undefined,
  })),
};
---

<nav aria-label="Breadcrumb" class="text-sm text-white/80">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {item.href ? (
            <a href={item.href} class="underline decoration-white/40 underline-offset-4 hover:text-white">
              {item.name}
            </a>
          ) : (
            <span aria-current="page" class="text-white">{item.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<JsonLd data={schema} />
