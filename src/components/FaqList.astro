---
import JsonLd from "./JsonLd.astro";
import type { Faq } from "../data/services";

interface Props {
  faqs: Faq[];
}
const { faqs } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<div class="divide-y divide-line rounded-brand border border-line bg-white shadow-card">
  {
    faqs.map((f) => (
      <details class="group p-5 sm:p-6">
        <summary class="flex cursor-pointer items-start justify-between gap-4 text-lg font-semibold text-primary focus-visible:rounded-brand">
          <span>{f.q}</span>
          <svg class="mt-1.5 h-5 w-5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <p class="mt-3 text-muted">{f.a}</p>
      </details>
    ))
  }
</div>
<JsonLd data={schema} />
