---
/**
 * LocalBusiness JSON-LD — brand name, city, phone and service type, all read
 * from site.config.ts. Phone, email and sameAs are omitted until real values exist.
 */
import JsonLd from "./JsonLd.astro";
import { site, hasPhone, hasEmail, activeSocials } from "../lib/site";
import { locations } from "../data/locations";

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${site.siteUrl}/#business`,
  name: site.businessName,
  url: site.siteUrl,
  description: site.metaDescription,
  telephone: hasPhone ? site.phoneNumber : undefined,
  email: hasEmail ? site.businessEmail : undefined,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address || undefined,
    addressLocality: site.city,
    addressRegion: site.stateAbbr,
    addressCountry: "US",
  },
  areaServed: [site.city, ...locations.map((l) => l.city)].map((name) => ({
    "@type": "City",
    name,
  })),
  serviceType: [
    "Water Softener Installation",
    "Water Softener Repair",
    "Water Softener Replacement",
    "Salt-Free Water Softener Systems",
    "Whole House Water Filtration",
    "Water Quality Testing",
  ],
  sameAs: activeSocials.length ? activeSocials.map((s) => s.url) : undefined,
};
---

<JsonLd data={schema} />
